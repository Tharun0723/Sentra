        <pose>19.85 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://factory_cladding/meshes/gable_end.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="east_gable_visual">
        <pose>19.85 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://factory_cladding/meshes/gable_end.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.59 1</ambient>
