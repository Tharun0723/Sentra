<?xml version="1.0"?>
<sdf version="1.9">
  <model name="factory_roundabout">
    <static>true</static>

    <link name="roundabout_link">

      <visual name="continuous_road">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://factory_roundabout/meshes/roundabout_ring.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.12 0.13 0.14 1</ambient>
          <diffuse>0.18 0.19 0.20 1</diffuse>
        </material>
      </visual>

      <collision name="continuous_road_collision">
        <geometry>
          <mesh>
            <uri>model://factory_roundabout/meshes/roundabout_ring.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="central_island">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>1.5</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.75 0.48 0.05 1</ambient>
          <diffuse>0.95 0.65 0.08 1</diffuse>
        </material>
      </visual>

      <collision name="central_island_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>1.5</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>

    
      <!-- Outer yellow safety marking -->
      <visual name="outer_yellow_visual">
        <pose>0 0 0.041 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://factory_roundabout/meshes/outer_yellow_line.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.75 0.02 1</ambient>
          <diffuse>1.0 0.85 0.02 1</diffuse>
        </material>
      </visual>

      <!-- Inner yellow safety marking -->
      <visual name="inner_yellow_visual">
        <pose>0 0 0.041 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://factory_roundabout/meshes/inner_yellow_line.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.75 0.02 1</ambient>
          <diffuse>1.0 0.85 0.02 1</diffuse>
        </material>
      </visual>

    
      
      <!-- Four indoor traffic direction arrows -->
      <visual name="directional_arrows_visual">
        <geometry>
          <mesh>
            <uri>model://factory_roundabout/meshes/directional_arrows.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <emissive>0.05 0.05 0.05 1</emissive>
        </material>
      </visual>

    </link>
  </model>
</sdf>
