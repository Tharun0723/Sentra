<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cnc_machine">
    <static>true</static>

    <link name="cnc_link">

      <!-- CNC machine visual -->
      <visual name="cnc_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/sentra_cnc_machine_gazebo.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- Simplified CNC enclosure collision -->
      <collision name="cnc_body_collision">
        <pose>0 0 0.925 1.5707963 0 0</pose>
        <geometry>
          <box>
            <size>2.45 2.55 1.85</size>
          </box>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
