    <!-- Reusable Industrial Roof Truss -->
    <include>
      <uri>model://roof_truss</uri>
      <name>roof_truss_1</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Roof Truss 2 -->
    <include>
      <uri>model://roof_truss</uri>
      <name>roof_truss_2</name>
      <pose>-16 0 0 0 0 0</pose>
    </include>

    <!-- Roof Truss 3 -->
