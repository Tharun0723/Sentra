
<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sentra_world">

    <!-- Physics engine -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Physics systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Gazebo sensor system for LiDAR and cameras -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- SENTRA Industrial Factory Floor -->
    <model name="factory_floor">
      <static>true</static>

      <pose>0 0 -0.1 0 0 0</pose>

      <link name="floor_link">

        <!-- Physical collision -->
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>40 30 0.2</size>
            </box>
          </geometry>
        </collision>

        <!-- Visible concrete surface -->
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>40 30 0.2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.16 0.17 0.18 1</ambient>
            <diffuse>0.24 0.25 0.26 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- Factory Perimeter Walls -->
    <model name="factory_walls">
      <static>true</static>

      <link name="wall_link">

        <!-- North Wall -->
        <collision name="north_collision">
          <pose>0 15 3 0 0 0</pose>
          <geometry>
            <box>
              <size>40 0.3 6</size>
            </box>
          </geometry>
        </collision>

        <visual name="north_visual">
          <pose>0 15 3 0 0 0</pose>
          <geometry>
            <box>
              <size>40 0.3 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.59 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>

        <!-- West Wall -->
        <collision name="west_collision">
          <pose>-20 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.3 30 6</size>
            </box>
          </geometry>
        </collision>

        <visual name="west_visual">
          <pose>-20 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.3 30 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.59 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>

        <!-- East Wall -->
        <collision name="east_collision">
          <pose>20 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.3 30 6</size>
            </box>
          </geometry>
        </collision>

        <visual name="east_visual">
          <pose>20 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.3 30 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.59 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>

        <!-- South Wall - Left Section -->
        <collision name="south_left_collision">
          <pose>-12.5 -15 3 0 0 0</pose>
          <geometry>
            <box>
              <size>15 0.3 6</size>
            </box>
          </geometry>
        </collision>

        <visual name="south_left_visual">
          <pose>-12.5 -15 3 0 0 0</pose>
          <geometry>
            <box>
              <size>15 0.3 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.59 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>

        <!-- South Wall - Right Section -->
        <collision name="south_right_collision">
          <pose>12.5 -15 3 0 0 0</pose>
          <geometry>
            <box>
              <size>15 0.3 6</size>
            </box>
          </geometry>
        </collision>

        <visual name="south_right_visual">
          <pose>12.5 -15 3 0 0 0</pose>
          <geometry>
            <box>
              <size>15 0.3 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.59 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>


        <!-- North Wall Roof Extension -->
        <collision name="north_extension_collision">
          <pose>0 15 6.14 0 0 0</pose>
          <geometry>
            <box><size>40 0.3 0.32</size></box>
          </geometry>
        </collision>

        <visual name="north_extension_visual">
          <pose>0 15 6.14 0 0 0</pose>
          <geometry>
            <box><size>40 0.3 0.32</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.59 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
          </material>
        </visual>

        <!-- South Left Roof Extension -->
        <collision name="south_left_extension_collision">
          <pose>-12.5 -15 6.14 0 0 0</pose>
          <geometry>
            <box><size>15 0.3 0.32</size></box>
          </geometry>
        </collision>

        <visual name="south_left_extension_visual">
          <pose>-12.5 -15 6.14 0 0 0</pose>
          <geometry>
            <box><size>15 0.3 0.32</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.59 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
          </material>
        </visual>

        <!-- South Right Roof Extension -->
