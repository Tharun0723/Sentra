<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sentra">

  <!-- Load the original SENTRA robot model -->
  <xacro:include filename="$(find sentra_description)/urdf/sentra.urdf.xacro"/>

  <!-- ROS 2 Control hardware interfaces -->
  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Left drive wheel -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Right drive wheel -->
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- Gazebo Harmonic ROS 2 Control plugin -->
  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>
        $(find sentra_gazebo)/config/controllers.yaml
      </parameters>

    </plugin>
  </gazebo>

</robot>