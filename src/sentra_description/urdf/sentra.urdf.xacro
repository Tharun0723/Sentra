<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sentra">
  <!--
    SENTRA inspection platform (visual model for RViz).

    Frames (z up, x forward, y left):
      base_link          body origin, on the ground plane at the drive-wheel midline
      left_wheel_link    driven wheel
      right_wheel_link   driven wheel
      mast_link          sensor tower
      lidar_link         2D LiDAR (placeholder until Gazebo)
      camera_link        forward RGB camera (placeholder)
      imu_link           IMU (placeholder)

    Drive type: differential (two side wheels). Casters are fixed spheres.
    Gazebo plugins are intentionally absent in this slice.
  -->

  <xacro:include filename="$(find sentra_description)/urdf/sentra_materials.xacro"/>

  <xacro:property name="wheel_radius" value="0.090"/>
  <xacro:property name="wheel_width" value="0.048"/>
  <xacro:property name="wheel_y" value="0.195"/>
  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="chassis_x" value="0.58"/>
  <xacro:property name="chassis_y" value="0.36"/>
  <xacro:property name="chassis_z" value="0.14"/>
  <xacro:property name="chassis_lift" value="0.125"/>

  <!-- ========== BASE / BODY ========== -->
  <!-- Several visuals share one link so TF stays small. Collision is a single box. -->
  <link name="base_link">
    <xacro:box_inertia mass="18.0" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}"/>
    <visual>
      <origin xyz="0 0 ${chassis_lift}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_x} ${chassis_y} ${chassis_z}"/>
      </geometry>
      <material name="safety_yellow"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${chassis_lift - 0.055}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_x - 0.04} ${chassis_y + 0.02} 0.05"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <visual>
      <origin xyz="${chassis_x/2 - 0.025} 0 ${chassis_lift}" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 ${chassis_y + 0.03} 0.10"/>
      </geometry>
      <material name="rubber_black"/>
    </visual>
    <visual>
      <origin xyz="-0.22 0 ${chassis_lift + 0.09}" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.22 0.05"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_lift}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_x} ${chassis_y} ${chassis_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- ========== DRIVE WHEELS (movable) ========== -->
  <xacro:macro name="drive_wheel" params="prefix y">
    <link name="${prefix}_wheel_link">
      <xacro:cylinder_inertia mass="1.2" radius="${wheel_radius}" length="${wheel_width}"/>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="rubber_black"/>
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.45}" length="${wheel_width + 0.01}"/>
        </geometry>
        <material name="metal_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y="${wheel_y}"/>
  <xacro:drive_wheel prefix="right" y="${-wheel_y}"/>

  <!-- ========== CASTERS (fixed) ========== -->
  <xacro:macro name="caster" params="name x y">
    <link name="${name}_link">
      <xacro:sphere_inertia mass="0.3" radius="${caster_radius}"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="metal_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${caster_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster name="front_left_caster" x="0.20" y="0.12"/>
  <xacro:caster name="front_right_caster" x="0.20" y="-0.12"/>
  <xacro:caster name="rear_left_caster" x="-0.22" y="0.12"/>
  <xacro:caster name="rear_right_caster" x="-0.22" y="-0.12"/>

  <!-- ========== SENSOR MAST ========== -->
  <link name="mast_link">
    <xacro:box_inertia mass="1.5" x="0.06" y="0.06" z="0.34"/>
    <visual>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.34"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.36" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="beacon_amber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.34"/>
      </geometry>
    </collision>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="-0.08 0 ${chassis_lift + chassis_z/2}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <xacro:cylinder_inertia mass="0.4" radius="0.05" length="0.06"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.42" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <xacro:box_inertia mass="0.15" x="0.04" y="0.08" z="0.04"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.04"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <visual>
      <origin xyz="0.025 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.01"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 0.28" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <xacro:box_inertia mass="0.05" x="0.03" y="0.03" z="0.02"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.05 0 ${chassis_lift}" rpy="0 0 0"/>
  </joint>
</robot>
