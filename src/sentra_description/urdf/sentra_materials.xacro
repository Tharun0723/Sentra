<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reusable colours and inertia helpers for SENTRA. Not a full robot by itself. -->

  <material name="safety_yellow">
    <color rgba="1.0 0.72 0.0 1.0"/>
  </material>
  <material name="charcoal">
    <color rgba="0.16 0.17 0.19 1.0"/>
  </material>
  <material name="rubber_black">
    <color rgba="0.07 0.07 0.07 1.0"/>
  </material>
  <material name="metal_grey">
    <color rgba="0.62 0.64 0.67 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>
  <material name="beacon_amber">
    <color rgba="1.0 0.38 0.05 1.0"/>
  </material>

  <!-- Solid box inertia about the link origin (assumes the box is centred on the origin). -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder along Z (URDF default). Rotate the joint/visual if the cylinder should lie on Y. -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3*radius*radius + length*length) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (3*radius*radius + length*length) / 12.0}"
        iyz="0.0"
        izz="${mass * radius*radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${0.4 * mass * radius * radius}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.4 * mass * radius * radius}"
        iyz="0.0"
        izz="${0.4 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>
</robot>
